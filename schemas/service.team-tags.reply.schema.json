{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/executor-registry/service.team-tags.reply.schema.json",
  "title": "service.team-tags.reply",
  "description": "Status 200. The same distinct tag set as ui.list-execution-tags, lexical order, unpaginated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tags"],
  "properties": {
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,128}$"
      }
    }
  }
}
