{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/executor-registry/ui.reissue.request.schema.json",
  "title": "ui.reissue.request",
  "description": "Request headers team=<team_id>, operator_id, request_id, team_name (optional). POST /ui/v1/teams/{team_id}/executors/{executor_id}/token.",
  "type": "object",
  "additionalProperties": false,
  "required": ["params"],
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_id", "executor_id"],
      "properties": {
        "team_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "executor_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}
