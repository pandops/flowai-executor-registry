{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/executor-registry/ui.create.request.schema.json",
  "title": "ui.create.request",
  "description": "Request headers team=<team_id>, operator_id, request_id, team_name (optional). POST /ui/v1/teams/{team_id}/executors. Exactly one execution_tag string and one supported executor_type; no executor_id, team_id, scope, name or display_name in the body.",
  "type": "object",
  "additionalProperties": false,
  "required": ["params", "body"],
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_id"],
      "properties": {
        "team_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_tag", "executor_type"],
      "properties": {
        "execution_tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "executor_type": {
          "type": "string",
          "enum": ["executor_docker_openhands", "executor_k8s_openhands"]
        }
      }
    }
  }
}
