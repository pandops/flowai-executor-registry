{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/executor-registry/executor.heartbeat.request.schema.json",
  "title": "executor.heartbeat.request",
  "description": "Subject executor-registry.executor.<executor_id>.heartbeat.pub; the Executor identity comes only from the subject token, and the team header is ignored (team derived from executor_id). No claim token. ip is lenient: an invalid value never fails the heartbeat.",
  "type": "object",
  "additionalProperties": false,
  "required": ["params", "body"],
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_type",
        "claims",
        "max_parallel_tasks",
        "slots_in_use",
        "interval_seconds",
        "miss_limit",
        "wait_seconds",
        "ip"
      ],
      "properties": {
        "claims": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "attempt", "claim_seq", "state"],
            "properties": {
              "task_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "attempt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "claim_seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "state": {
                "enum": ["created", "pending", "running"]
              }
            }
          }
        },
        "max_parallel_tasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "slots_in_use": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "miss_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "wait_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "ip": {
          "description": "Address of the Executor's own primary network interface (IPv4 dotted quad or RFC 5952 IPv6), or null. An invalid value never fails the heartbeat.",
          "type": ["string", "null"]
        },
        "executor_type": {
          "type": "string",
          "enum": ["executor_docker_openhands", "executor_k8s_openhands"]
        }
      }
    }
  }
}
