{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/executor-registry/error.reply.schema.json",
  "title": "error.reply",
  "description": "Body of every error reply; the status is the NATS reply header status. request_id is absent only when the request carried no valid request_id header.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "message": {
      "type": "string",
      "maxLength": 512
    },
    "request_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
